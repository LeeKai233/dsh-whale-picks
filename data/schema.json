{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dsh-whale-picks registry schema",
  "description": "Schema for the whale-picks curated registry (v1.1: adds spec compliance gate + six-axis radar). data/plugins.json is the single source of truth; README files are rendered from it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "dshVersion",
    "updatedAt",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "dshVersion": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/plugin"
      }
    }
  },
  "definitions": {
    "score": {
      "type": "object",
      "required": [
        "experience",
        "maintenance",
        "security",
        "compatibility"
      ],
      "additionalProperties": false,
      "properties": {
        "experience": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "maintenance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "security": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "compatibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "bilingual": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "scannedAt",
        "reviewStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "scannedAt": {
          "type": "string"
        },
        "reviewStatus": {
          "enum": [
            "none",
            "pending-human",
            "reviewed"
          ]
        },
        "hasLicense": {
          "type": "boolean"
        },
        "npmPublished": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "repoPointerMatch": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pushedRecent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "redFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "axis": {
      "type": "object",
      "required": [
        "value",
        "evidence",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "evidence": {
          "type": "string",
          "minLength": 4
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        }
      }
    },
    "humanAxis": {
      "type": "object",
      "required": [
        "value",
        "source",
        "count",
        "evidence",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "source": {
          "enum": [
            "founder",
            "community",
            "both"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "string",
          "minLength": 4
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        }
      }
    },
    "radar": {
      "type": "object",
      "required": [
        "human",
        "security",
        "compatibility",
        "scope",
        "cost",
        "activity"
      ],
      "additionalProperties": false,
      "properties": {
        "human": {
          "$ref": "#/definitions/humanAxis"
        },
        "security": {
          "$ref": "#/definitions/axis"
        },
        "compatibility": {
          "$ref": "#/definitions/axis"
        },
        "scope": {
          "$ref": "#/definitions/axis"
        },
        "cost": {
          "$ref": "#/definitions/axis"
        },
        "activity": {
          "$ref": "#/definitions/axis"
        }
      }
    },
    "patches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "insertIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "repo",
        "tier",
        "category",
        "license",
        "stars",
        "pushedAt",
        "archived",
        "security",
        "description",
        "submittedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "npmName": {
          "type": [
            "string",
            "null"
          ]
        },
        "install": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "enum": [
            "featured",
            "listed",
            "candidate"
          ]
        },
        "category": {
          "enum": [
            "discovery",
            "ui",
            "terminal-desktop",
            "agents",
            "usage",
            "notifications"
          ]
        },
        "license": {
          "type": "string"
        },
        "stars": {
          "type": "integer",
          "minimum": 0
        },
        "pushedAt": {
          "type": "string"
        },
        "archived": {
          "type": "boolean"
        },
        "verifiedAgainst": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastVerified": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/score"
            }
          ]
        },
        "security": {
          "$ref": "#/definitions/security"
        },
        "reviewNotes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/bilingual"
            }
          ]
        },
        "description": {
          "$ref": "#/definitions/bilingual"
        },
        "submittedAt": {
          "type": "string"
        },
        "listedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "specVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifestCompliant": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "patches": {
          "$ref": "#/definitions/patches"
        },
        "radar": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/radar"
            }
          ]
        }
      }
    }
  }
}
