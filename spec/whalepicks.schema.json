{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "whalepicks.json manifest v1.1",
  "description": "The whale-picks plugin manifest. Lives at the root of a plugin repo. It is the listing contract: agents read it to build/refactor plugins, the store's check-plugin validates it, and compliance is the admission gate (one-vote veto). v1.1 adds optional deps/perf/security fields consumed by the dsh-appearance manager's conflict/danger/performance checks; 1.0 manifests remain valid.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "category",
    "scope",
    "install",
    "runtime",
    "patches",
    "capabilities",
    "cost",
    "links",
    "maintainers"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.0 = base manifest; 1.1 adds the optional deps/perf/security fields"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Stable slug, unique across the whale-picks store"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "npm package name (install id); must equal package.json name"
    },
    "version": {
      "type": "string",
      "description": "Must equal package.json version"
    },
    "description": {
      "$ref": "#/definitions/bilingual"
    },
    "category": {
      "enum": [
        "discovery",
        "ui",
        "terminal-desktop",
        "agents",
        "usage",
        "notifications",
        "other"
      ]
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "default": []
    },
    "scope": {
      "type": "object",
      "required": [
        "does",
        "doesNot"
      ],
      "additionalProperties": false,
      "properties": {
        "does": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 3,
          "description": "The ONE thing it does (Unix philosophy); keep it tight"
        },
        "doesNot": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Explicit non-goals — what it refuses to do"
        }
      }
    },
    "install": {
      "type": "object",
      "required": [
        "profile",
        "spec"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "web",
            "tui",
            "headless",
            "any"
          ]
        },
        "spec": {
          "type": "string",
          "description": "pnpm spec for 'dsh plugin add' (npm name, or github:owner/repo)"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "platforms",
        "dsh"
      ],
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "web",
              "tui",
              "headless"
            ]
          },
          "minItems": 1
        },
        "dsh": {
          "type": "string",
          "description": "semver range, e.g. '>=0.1.0-rc.6 <0.2.0'"
        }
      }
    },
    "patches": {
      "type": "object",
      "required": [
        "bundle",
        "insertIds"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "string",
          "description": "Path to the cordis patch, usually cordis.patch.yml"
        },
        "insertIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every insert id declared in the bundle patch — the conflict surface"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "network",
        "telemetry"
      ],
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean"
        },
        "telemetry": {
          "type": "boolean"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Whale-picks plugin ids this plugin requires (conflict surface for the appearance manager)"
    },
    "perf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polls": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 1000
          },
          "default": {},
          "description": "Named poll cadences in milliseconds"
        },
        "memoryEstimateMB": {
          "type": "number",
          "minimum": 0,
          "description": "Declared steady-state memory estimate in MB"
        },
        "gpu": {
          "type": "boolean",
          "description": "Whether the plugin claims GPU/VRAM usage"
        },
        "timers": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of long-lived timers/interval loops"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "passed",
            "review",
            "unknown"
          ]
        },
        "scanBy": {
          "type": "string",
          "description": "Which pipeline produced the verdict, e.g. whalepicks check-plugin"
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "license",
        "paid"
      ],
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "string",
          "description": "SPDX id"
        },
        "paid": {
          "type": "boolean"
        },
        "paidTiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "links": {
      "type": "object",
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "npm": {
          "type": "string"
        },
        "docs": {
          "type": "string"
        }
      }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/maintainer"
      }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "maintainer": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      }
    }
  }
}
